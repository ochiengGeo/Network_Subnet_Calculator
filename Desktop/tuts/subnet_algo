import java.util.Scanner;

public class trial_subnetmask {
    public static void main (String[] args) {
        int octet4 = 255, octet3 = 255, octet2 = 255, octet1 = 255;
        System.out.print("Enter the Number of hostbits: ");
        Scanner cin = new Scanner(System.in);
        int hostbits = cin.nextInt();
        cin.nextLine();
        
        if (hostbits <= 8) {
            switch (hostbits) {
                case 1:
                    octet1 = 128;
                    break;
                case 3:
                    octet1 = 128+64+32;
                    break;
                case 4:
                    octet1 = 128+64+32+16;
                    break;
                case 5:
                    octet1 = 128+64+32+16+8;
                    break;
                case 6:
                    octet1 = 128+64+32+16+8+4;
                    break;
                case 7:
                    octet1 = 128+64+32+16+8+4+2;
                    break;
                case 2:
                    octet1 = 128+64;
                    break;
                case 8:
                    octet1 = 0;
                    break;
            
                default:
                    octet1 = 255;
                    break;
            }

        }
        
        System.out.println("Subnet Mask: " + octet4+ "." +octet3+ "." +octet2+ "." +octet1);
        cin.close();

    }
}
