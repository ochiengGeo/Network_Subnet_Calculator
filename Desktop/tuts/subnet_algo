        System.out.print("Enter the Number of hostbits: ");
        Scanner cin = new Scanner(System.in);
        int hostbits = cin.nextInt();
        cin.nextLine();

        if (hostbits <= 8) {

                for (int j = 8; j > 0; j--) {
                    octet1 += Math.pow(2, (j-1)) ;
                    if ((8 - j) == (hostbits - 1)) {
                        j = -1;
                    }

            }
        }
        System.out.println("Subnet Mask: " + octet4+ "." +octet3+ "." +octet2+ "." +octet1);
        cin.close();

    }
}
